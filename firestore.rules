rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if ownsUserDoc(userId);
      allow create: if ownsUserDoc(userId)
        && request.resource.data.keys().hasOnly([
          "displayName",
          "email",
          "photoURL",
          "updatedAt"
        ]);
      allow update: if ownsUserDoc(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "displayName",
          "email",
          "photoURL",
          "updatedAt"
        ]);
      allow delete: if false;

      match /integrations/{integrationId} {
        allow read: if false;
        allow write: if false;
      }
    }

    match /settings/{userId} {
      allow read: if ownsUserDoc(userId);
      allow create, update: if ownsUserDoc(userId)
        && request.resource.data.userId == userId
        && request.resource.data.keys().hasOnly([
          "userId",
          "uploadDelayMinutes",
          "privacy",
          "autoMetadata",
          "autoPublish",
          "updatedAt"
        ])
        && request.resource.data.uploadDelayMinutes is int
        && request.resource.data.uploadDelayMinutes >= 0
        && request.resource.data.uploadDelayMinutes <= 1440
        && request.resource.data.privacy in ["public", "private", "unlisted"]
        && request.resource.data.autoMetadata is bool
        && request.resource.data.autoPublish is bool;
      allow delete: if false;
    }

    match /videos/{videoId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.uploaded == false
        && request.resource.data.status in ["pending", "scheduled"];
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "title",
          "metadata",
          "scheduledAt",
          "updatedAt"
        ]);
      allow delete: if signedIn() && resource.data.userId == request.auth.uid && resource.data.status != "uploading";
    }

    match /uploads/{uploadId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /rateLimits/{key} {
      allow read, write: if false;
    }

    match /locks/{lockId} {
      allow read, write: if false;
    }
  }
}
